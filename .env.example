PORT=3000
# Ambiente: deixe VAZIO no dev (`npm run dev`). `production` liga as exigências de produção — hoje: SMTP obrigatório no boot (D-RS5).
# `npm start` (build em dist/) assume production quando a variável está vazia (scripts/start-production.js — Q-RS11).
NODE_ENV=
# JWT do produto (D-F13 — F2a etapa A2): RS256 com kid. O setes-api ASSINA com a chave PRIVADA; nfse-api/nfe-api
# só têm a PÚBLICA (JWT_PUBLIC_KEY_PATH delas). Gerar o par fora do repositório (secrets/ está no .gitignore):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt/setes-api.private.pem
#   openssl pkey -in secrets/jwt/setes-api.private.pem -pubout -out secrets/jwt/setes-api.public.pem
# Sem a chave o servidor NÃO sobe. JWT_SECRET (HS256) foi APOSENTADA — não é lida.
JWT_PRIVATE_KEY_PATH=./secrets/jwt/setes-api.private.pem
# kid da chave de assinatura (padrão "default" — o nome que a nfse-api dá a JWT_PUBLIC_KEY_PATH)
JWT_KID=default
# ROTAÇÃO: chaves ANTERIORES ainda aceitas na verificação até os tokens delas expirarem ("kid=caminho.pem,…")
JWT_PUBLIC_KEYS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha
DB_NAME=setes_central
FLAG_CACHE_TTL_MS=60000
# setes-app Fase 1 (decisão 16): storage de logomarcas servidas pela API
STORAGE_PATH=./storage
# cofre de segredos por dono (canal API da conta: certificado mTLS + chave + client_secret;
# certificado A1 da NFS-e) — fora do repositório e fora do banco (peça @shared/secret-store)
SECRETS_PATH=./secrets
# CORS do setes-app web (dev: *; produção: domínio do app)
CORS_ORIGIN=*
# ---------------------------------------------------------------------------------------------------------------------
# SMTP — peça @shared/mailer: código de recuperação de senha (Q-PV38) e aviso ao DONO da conta quando um código esgota
# ou o teto de pedidos é atingido (D-RS4). Valores REAIS só no `.env` vivo, fornecidos pelo Valdo na publicação — nunca
# neste arquivo nem em qualquer arquivo versionado.
# Vazio = modo DEV: o código vai ao LOG e nenhum e-mail sai. Em PRODUÇÃO (NODE_ENV=production) o SMTP é OBRIGATÓRIO:
# o boot recusa subir com host ausente, porta inválida, credencial pela metade ou sem remetente (D-RS5);
# `scripts/pre-deploy-tz-check.ts` abre a conexão e autentica ANTES do deploy, sem enviar nada.
# ---------------------------------------------------------------------------------------------------------------------
SMTP_HOST=
# 465 = SSL implícito | 587 = STARTTLS. A criptografia é DERIVADA da porta (SMTP_SECURE, se existir no .env, é ignorada —
# a porta manda, para nunca cair no "wrong version number").
SMTP_PORT=587
# Usuário e senha andam JUNTOS (um sem o outro = configuração incompleta); os dois vazios = relay sem autenticação.
SMTP_USER=
SMTP_PASSWORD=
# Remetente (obrigatório quando não há SMTP_USER)
SMTP_FROM="Setes ERP <nao-responda@setes.com.br>"
# Link do botão no email de recuperação (aponta para o setes-app web)
APP_CHANGE_PASSWORD_URL=http://localhost:5050/#/change-password

PORT=3000
# JWT do produto (D-F13 — F2a etapa A2): RS256 com kid. O setes-api ASSINA com a chave PRIVADA; nfse-api/nfe-api
# só têm a PÚBLICA (JWT_PUBLIC_KEY_PATH delas). Gerar o par fora do repositório (secrets/ está no .gitignore):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt/setes-api.private.pem
#   openssl pkey -in secrets/jwt/setes-api.private.pem -pubout -out secrets/jwt/setes-api.public.pem
# Sem a chave o servidor NÃO sobe. JWT_SECRET (HS256) foi APOSENTADA — não é lida.
JWT_PRIVATE_KEY_PATH=./secrets/jwt/setes-api.private.pem
# kid da chave de assinatura (padrão "default" — o nome que a nfse-api dá a JWT_PUBLIC_KEY_PATH)
JWT_KID=default
# ROTAÇÃO: chaves ANTERIORES ainda aceitas na verificação até os tokens delas expirarem ("kid=caminho.pem,…")
JWT_PUBLIC_KEYS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha
DB_NAME=setes_central
FLAG_CACHE_TTL_MS=60000
# setes-app Fase 1 (decisão 16): storage de logomarcas servidas pela API
STORAGE_PATH=./storage
# cofre de segredos por dono (canal API da conta: certificado mTLS + chave + client_secret;
# certificado A1 da NFS-e) — fora do repositório e fora do banco (peça @shared/secret-store)
SECRETS_PATH=./secrets
# CORS do setes-app web (dev: *; produção: domínio do app)
CORS_ORIGIN=*
# SMTP — envio do código de recuperação de senha (vazio = modo dev: código no log)
SMTP_HOST=
# 465 = SSL implícito | 587 = STARTTLS (a criptografia é derivada da porta)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Setes ERP <nao-responda@setes.com.br>"
# Link do botão no email de recuperação (aponta para o setes-app web)
APP_CHANGE_PASSWORD_URL=http://localhost:5050/#/change-password

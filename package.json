{
  "name": "setes-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/server.ts",
    "db:bootstrap": "tsx --require tsconfig-paths/register scripts/bootstrap-db.ts",
    "db:migrate": "tsx --require tsconfig-paths/register scripts/run-migrations.ts",
    "fields:gen": "tsx scripts/gerar-interface-fields.ts",
    "errors:gen": "tsx scripts/gerar-error-catalog.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.13",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@gateway/(.*)$": "<rootDir>/src/gateway/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@feature-flags/(.*)$": "<rootDir>/src/feature-flags/$1"
    }
  }
}
